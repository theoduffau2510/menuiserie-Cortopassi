---
import { site } from '../data/site';
import { villes } from '../data/villes';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.cortopassi-menuiserie.fr/#business',
  name: site.name,
  alternateName: 'Menuiserie à Sainte-Anastasie-sur-Issole',
  serviceType: 'Menuiserie bois sur mesure',
  description:
    "Menuiserie Cortopassi à Sainte-Anastasie-sur-Issole, spécialisée dans la menuiserie bois sur mesure pour particuliers et professionnels dans le Var.",
  url: 'https://www.cortopassi-menuiserie.fr',
  telephone: site.phoneHref,
  email: site.email,
  image: 'https://www.cortopassi-menuiserie.fr/images/WhatsApp%20Image%202026-09-26%20at%2010.22.09%20(2).jpeg',
  hasMap: site.googleBusinessUrl,
  priceRange: '€€',
  knowsAbout: [
    'Menuiserie bois sur mesure',
    'Portes et fenêtres en bois',
    'Volets et persiennes',
    'Agencement intérieur',
    'Escaliers et meubles sur mesure',
    'Parquets et terrasses en bois',
  ],
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.3389263,
    longitude: 6.1186193,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: villes.map((v) => ({ '@type': 'City', name: v.name })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
  sameAs: [site.social.facebook, site.social.instagram],
};
---

<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
