---
import { site } from '../data/site';
import { villes } from '../data/villes';

const year = new Date().getFullYear();
---

<footer class="bg-noyer text-kraft">
  <div class="container-page grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="font-display text-xl mb-3">{site.name}</p>
      <p class="text-sm text-kraft/75 leading-relaxed">
        Atelier de menuiserie à {site.address.city}, dans le Var. Mobilier aux dimensions du lieu, agencement
        intérieur, extérieur et rénovation de menuiseries.
      </p>
    </div>

    <div>
      <p class="font-display text-lg mb-3">Contact</p>
      <ul class="space-y-2 text-sm text-kraft/75">
        <li>{site.address.street}, {site.address.postalCode} {site.address.city}</li>
        <li>
          <a href={`tel:${site.phoneHref}`} class="hover:text-cordeau">{site.phone}</a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="hover:text-cordeau">{site.email}</a>
        </li>
        <li>
          <a href={site.googleBusinessUrl} target="_blank" rel="noopener noreferrer" class="hover:text-cordeau underline">
            Voir la fiche Google Business
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-lg mb-3">Zone d'intervention</p>
      <p class="text-sm text-kraft/75 leading-relaxed">
        {villes.slice(0, 6).map((v) => v.name).join(', ')} et environs.
        <a href="/zone-intervention/" class="underline hover:text-cordeau">Voir toutes les villes</a>
      </p>
    </div>
  </div>

  <div class="border-t border-kraft/15 py-4 text-center text-xs text-kraft/50">
    &copy; {year} {site.name} — Artisan menuisier dans le Var
  </div>
</footer>
