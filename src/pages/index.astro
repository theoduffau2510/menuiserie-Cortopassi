---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { projects } from '../data/projects';
import { services } from '../data/services';
import { site } from '../data/site';

const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout
  title="Menuisier artisan à Sainte-Anastasie-sur-Issole | Menuiserie Cortopassi"
  description="Menuiserie Cortopassi, artisan menuisier basé à Sainte-Anastasie-sur-Issole, réalise du mobilier, de l'agencement intérieur et des aménagements extérieurs dans tout le Var : Toulon, Draguignan, Fréjus et alentours."
  path="/"
>
  <section class="section pt-10 md:pt-16">
    <div class="container-page grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <h1 class="text-4xl md:text-5xl leading-tight mb-5">
          Cortopassi fabrique dans le Var
        </h1>
        <p class="text-lg text-noyer/85 leading-relaxed mb-8 max-w-xl">
          Depuis mon atelier de {site.address.city}, je fabrique du mobilier,
          des agencements intérieurs et des ouvrages extérieurs en bois pour
          les particuliers et professionnels du Var.
        </p>
        <a href="/contact/" class="btn-primary">Parler de votre projet</a>
        <dl class="mt-10 grid max-w-xl grid-cols-2 border-t border-noyer/25 pt-4 text-sm">
          <div class="border-r border-noyer/25 pr-4">
            <dt class="text-noyer/55">Atelier</dt>
            <dd class="mt-1 font-medium">{site.address.city}</dd>
          </div>
          <div class="pl-4">
            <dt class="text-noyer/55">Zone</dt>
            <dd class="mt-1 font-medium">Tout le Var</dd>
          </div>
        </dl>
      </div>
      <div class="screen-frame relative overflow-hidden">
        <img
          src="/images/WhatsApp%20Image%202026-09-26%20at%2010.22.09%20(2).jpeg"
          alt="Atelier de la Menuiserie Cortopassi à Sainte-Anastasie-sur-Issole"
          loading="eager"
          decoding="async"
          width="2000"
          height="1500"
          class="screen-image h-full object-cover"
        />
        <div class="absolute bottom-5 left-5 right-5 flex items-center gap-2 text-cordeau" aria-hidden="true">
          <span class="h-3 w-px bg-cordeau"></span>
          <span class="flex-1 border-t border-cordeau cordeau-trait"></span>
          <span class="h-3 w-px bg-cordeau"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-kraft-light">
    <div class="container-page grid gap-10 md:grid-cols-2 md:items-center">
      <div class="order-2 md:order-1 overflow-hidden border border-noyer/25">
        <img
          src="/images/artisan-atelier.svg"
          alt="Artisan menuisier travaillant le bois dans son atelier du Var"
          loading="lazy"
          decoding="async"
          width="900"
          height="1100"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="order-1 md:order-2">
        <h2 class="text-3xl mb-4">Un atelier de menuiserie dans le Var</h2>
        <p class="text-noyer/85 leading-relaxed mb-4 max-w-xl">
          Je travaille le chêne, le noyer, le hêtre et le douglas.
          Chaque pièce est dessinée selon les dimensions du lieu et l’usage
          prévu.
        </p>
        <p class="text-noyer/85 leading-relaxed mb-6 max-w-xl">
          J'interviens dans tout le Var, de Toulon à Fréjus en passant par Draguignan, Brignoles et
          Sainte-Maxime, pour des projets de mobilier, d'agencement, d'aménagement extérieur et de
          rénovation de menuiseries anciennes.
        </p>
        <a href="/zone-intervention/" class="btn-secondary">Découvrir la zone d'intervention</a>
      </div>
    </div>
  </section>

  <section class="section plan-watermark">
    <div class="container-page">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl mb-4">Nos réalisations phares dans le Var</h2>
        <p class="text-noyer/75">
          Quatre chantiers précis : une essence, une contrainte et une méthode
          de fabrication pour chaque pièce.
        </p>
      </div>
      <div class="project-rail-wrap">
        <div class="project-rail" id="featured-projects" tabindex="0" aria-label="Réalisations phares">
          {featuredProjects.map((project, index) => (
            <article
              class:list={['project-rail-item', index === 0 && 'is-active']}
              data-index={index}
              tabindex="0"
            >
              <img
                src={project.image}
                alt={project.alt}
                loading="lazy"
                decoding="async"
                width={project.imageWidth}
                height={project.imageHeight}
                class="project-rail-image rounded-2xl border border-noyer/30 bg-kraft shadow-lg"
              />
              <div class="project-rail-caption border-t border-noyer/25 pt-4">
                <p class="text-sm text-cordeau mb-2">{project.city}</p>
                <h3 class="text-2xl mb-2">{project.title}</h3>
                <p class="text-xs text-noyer/60 mb-3">{project.dimensions} · {project.material}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="mt-10">
        <a href="/realisations/" class="btn-secondary">Voir toutes les réalisations</a>
      </div>
    </div>
  </section>

  <section class="section bg-kraft-light plan-watermark">
    <div class="container-page">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl mb-4">Nos prestations de menuiserie</h2>
        <p class="text-noyer/75">
          Mobilier aux dimensions du lieu, agencement intérieur,
          ouvrages extérieurs et restauration de menuiseries dans le Var.
        </p>
      </div>
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        <a href={`/services/#${services[0].slug}`} class="block border-l-4 border-cordeau p-7 hover:border-noyer">
          <h3 class="text-3xl mb-3">{services[0].title}</h3>
          <p class="text-noyer/75 leading-relaxed">{services[0].description}</p>
        </a>
        <div class="border-t border-noyer/25">
          {services.slice(1).map((service) => (
            <a href={`/services/#${service.slug}`} class="block border-b border-noyer/25 py-5 hover:text-cordeau">
              <h3 class="text-2xl mb-1">{service.title}</h3>
              <p class="text-sm text-noyer/70">{service.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<script>
  const railItems = Array.from(document.querySelectorAll<HTMLElement>('.project-rail-item'));
  const projectRail = document.getElementById('featured-projects');
  let activeIndex = 0;
  let railBalanceTimer: number | undefined;

  const setActiveProject = (index: number) => {
    if (!railItems.length) return;
    activeIndex = (index + railItems.length) % railItems.length;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const sideScale = isMobile ? 0.6 : 0.64;
    const sideAngle = (isMobile ? 20 : 24) * Math.PI / 180;
    const perspectiveScale = 1800 / (1800 + (isMobile ? 140 : 180));
    const gap = isMobile ? 20 : 32;
    const activeWidth = railItems[activeIndex].offsetWidth;
    const leftItem = railItems[(activeIndex + railItems.length - 1) % railItems.length];
    const rightItem = railItems[(activeIndex + 1) % railItems.length];
    const sideWidth = Math.max(leftItem.offsetWidth, rightItem.offsetWidth);
    const sideOffset = activeWidth / (2 * perspectiveScale) + sideWidth * sideScale * Math.cos(sideAngle) / 2 + gap / perspectiveScale;
    railItems.forEach((item, itemIndex) => {
      const isActive = itemIndex === activeIndex;
      const isLeft = itemIndex === (activeIndex + railItems.length - 1) % railItems.length;
      const isRight = itemIndex === (activeIndex + 1) % railItems.length;
      item.classList.toggle('is-active', isActive);
      item.classList.toggle('is-left', isLeft);
      item.classList.toggle('is-right', isRight);
      item.classList.toggle('is-far', itemIndex === (activeIndex + 2) % railItems.length);
      item.style.setProperty('--rail-x-offset', `${isLeft ? -sideOffset : isRight ? sideOffset : 0}px`);
    });

    if (railBalanceTimer !== undefined) window.clearTimeout(railBalanceTimer);
    railBalanceTimer = window.setTimeout(() => {
      const active = railItems[activeIndex];
      const left = railItems.find((item) => item.classList.contains('is-left'));
      const right = railItems.find((item) => item.classList.contains('is-right'));
      if (!active || !left || !right) return;

      const center = (item: HTMLElement) => {
        const rect = item.getBoundingClientRect();
        return rect.left + rect.width / 2;
      };
      const correction = ((center(active) - center(left)) - (center(right) - center(active))) / 2;
      const depth = window.matchMedia('(max-width: 767px)').matches ? 140 : 180;
      const perspectiveScale = 1800 / (1800 + depth);
      const adjustment = correction / perspectiveScale;
      left.style.setProperty('--rail-x-offset', `${parseFloat(left.style.getPropertyValue('--rail-x-offset')) + adjustment}px`);
      right.style.setProperty('--rail-x-offset', `${parseFloat(right.style.getPropertyValue('--rail-x-offset')) + adjustment}px`);
    }, 780);
  };

  railItems.forEach((item) => {
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        setActiveProject(Number(item.dataset.index));
      }
    });
  });

  projectRail?.addEventListener('click', (event) => {
    const clickedItem = event.target instanceof Element
      ? event.target.closest<HTMLElement>('.project-rail-item')
      : null;

    if (clickedItem && !clickedItem.classList.contains('is-active')) {
      setActiveProject(Number(clickedItem.dataset.index));
      return;
    }

    const activeRect = railItems[activeIndex]?.getBoundingClientRect();
    if (!activeRect) return;
    if (event.clientX < activeRect.left) setActiveProject(activeIndex - 1);
    if (event.clientX > activeRect.right) setActiveProject(activeIndex + 1);
  });

  setActiveProject(0);
  window.addEventListener('resize', () => setActiveProject(activeIndex));
</script>

<style>
  .project-rail-wrap {
    overflow: visible;
    perspective: 1800px;
  }

  .project-rail {
    position: relative;
    min-height: 34rem;
    transform-style: preserve-3d;
  }

  .project-rail-item {
    position: absolute;
    top: 50%;
    left: calc(50% + var(--rail-x-offset, 0px));
    width: min(78vw, 35rem);
    cursor: pointer;
    opacity: 0.4;
    transform-style: preserve-3d;
    transform: translate(-50%, -50%) translateZ(-380px) scale(0.6);
    will-change: transform, opacity;
    backface-visibility: hidden;
    transition:
      transform 760ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 520ms ease;
  }

  .project-rail-item.is-active {
    z-index: 4;
    opacity: 1;
    cursor: default;
    pointer-events: none;
    transform: translate(-50%, -50%) translateZ(0) scale(1);
  }

  .project-rail-item.is-left {
    z-index: 3;
    opacity: 0.75;
    pointer-events: auto;
    transform: translate(-50%, -50%) translateZ(-180px) rotateY(24deg) scale(0.64);
  }

  .project-rail-item.is-right {
    z-index: 3;
    opacity: 0.75;
    pointer-events: auto;
    transform: translate(-50%, -50%) translateZ(-180px) rotateY(-24deg) scale(0.64);
  }

  @media (max-width: 767px) {
    .project-rail {
      min-height: 25rem;
    }

    .project-rail-item {
      width: 84vw;
    }

    .project-rail-item.is-left {
      transform: translate(-50%, -50%) translateZ(-140px) rotateY(20deg) scale(0.6);
    }

    .project-rail-item.is-right {
      transform: translate(-50%, -50%) translateZ(-140px) rotateY(-20deg) scale(0.6);
    }
  }

  .project-rail-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }

  .project-rail-item:not(.is-active) .project-rail-caption {
    display: none;
  }
</style>
