---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { projects } from '../data/projects';
import { services } from '../data/services';
import { site } from '../data/site';

const featuredProjects = projects;
---

<BaseLayout
  title="Menuiserie à Sainte-Anastasie-sur-Issole | Cortopassi"
  description="Menuiserie Cortopassi à Sainte-Anastasie-sur-Issole : menuiserie bois sur mesure, portes, fenêtres, volets, agencements, meubles, parquets et terrasses dans le Var."
  path="/"
>
  <section id="accueil" class="relative isolate flex min-h-80 items-center overflow-hidden bg-noyer md:min-h-[42rem]">
    <img
      src="/images/WhatsApp%20Image%202026-09-26%20at%2010.22.09%20(2).jpeg"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      width="2000"
      height="1500"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-noyer/90 via-noyer/60 to-noyer/45 md:bg-gradient-to-r md:from-noyer/90 md:via-noyer/70 md:to-noyer/25"></div>
    <div class="container-page w-full py-6 md:py-24">
      <h1 class="sr-only">Menuiserie Cortopassi, menuisier bois sur mesure dans le Var</h1>
      <p class="max-w-2xl text-sm leading-5 text-white sm:text-base sm:leading-6 md:text-lg md:leading-relaxed">
        Depuis mon atelier partagé situé à {site.address.city}, je réalise sur mesure tous types de travaux de menuiserie en bois.<br />
        Je conçois, fabrique et pose des portes, fenêtres, volets, persiennes, agencements intérieurs, escaliers, meubles, parquets et terrasses.
      </p>
    </div>
  </section>

  <section id="realisations" class="section plan-watermark">
    <div class="container-page">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl mb-4">Réalisations</h2>
      </div>
      <div class="project-rail-wrap">
        <div class="project-rail" id="featured-projects" tabindex="0" aria-label="Réalisations phares">
          {featuredProjects.map((project, index) => (
            <article
              class:list={['project-rail-item', index === 0 && 'is-active']}
              data-index={index}
              tabindex="0"
            >
              <img
                src={project.image}
                alt={project.alt}
                loading="lazy"
                decoding="async"
                width={project.imageWidth}
                height={project.imageHeight}
                class="project-rail-image rounded-2xl border border-noyer/30 bg-kraft shadow-lg"
              />
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<script>
  const railItems = Array.from(document.querySelectorAll<HTMLElement>('.project-rail-item'));
  const projectRail = document.getElementById('featured-projects');
  let activeIndex = 0;
  let railBalanceTimer: number | undefined;
  let pointerStart: { pointerId: number; x: number; y: number } | null = null;
  let suppressClick = false;

  const setActiveProject = (index: number) => {
    if (!railItems.length) return;
    activeIndex = (index + railItems.length) % railItems.length;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const sideScale = isMobile ? 0.6 : 0.64;
    const sideAngle = (isMobile ? 20 : 24) * Math.PI / 180;
    const perspectiveScale = 1800 / (1800 + (isMobile ? 140 : 180));
    const gap = isMobile ? 20 : 32;
    const activeWidth = railItems[activeIndex].offsetWidth;
    const leftItem = railItems[(activeIndex + railItems.length - 1) % railItems.length];
    const rightItem = railItems[(activeIndex + 1) % railItems.length];
    const sideWidth = Math.max(leftItem.offsetWidth, rightItem.offsetWidth);
    const sideOffset = activeWidth / (2 * perspectiveScale) + sideWidth * sideScale * Math.cos(sideAngle) / 2 + gap / perspectiveScale;
    railItems.forEach((item, itemIndex) => {
      const isActive = itemIndex === activeIndex;
      const isLeft = itemIndex === (activeIndex + railItems.length - 1) % railItems.length;
      const isRight = itemIndex === (activeIndex + 1) % railItems.length;
      item.classList.toggle('is-active', isActive);
      item.classList.toggle('is-left', isLeft);
      item.classList.toggle('is-right', isRight);
      item.classList.toggle('is-far', itemIndex === (activeIndex + 2) % railItems.length);
      item.style.setProperty('--rail-x-offset', `${isLeft ? -sideOffset : isRight ? sideOffset : 0}px`);
    });

    if (railBalanceTimer !== undefined) window.clearTimeout(railBalanceTimer);
    railBalanceTimer = window.setTimeout(() => {
      const active = railItems[activeIndex];
      const left = railItems.find((item) => item.classList.contains('is-left'));
      const right = railItems.find((item) => item.classList.contains('is-right'));
      if (!active || !left || !right) return;

      const center = (item: HTMLElement) => {
        const rect = item.getBoundingClientRect();
        return rect.left + rect.width / 2;
      };
      const correction = ((center(active) - center(left)) - (center(right) - center(active))) / 2;
      const depth = window.matchMedia('(max-width: 767px)').matches ? 140 : 180;
      const perspectiveScale = 1800 / (1800 + depth);
      const adjustment = correction / perspectiveScale;
      left.style.setProperty('--rail-x-offset', `${parseFloat(left.style.getPropertyValue('--rail-x-offset')) + adjustment}px`);
      right.style.setProperty('--rail-x-offset', `${parseFloat(right.style.getPropertyValue('--rail-x-offset')) + adjustment}px`);
    }, 780);
  };

  railItems.forEach((item) => {
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        setActiveProject(Number(item.dataset.index));
      }
    });
  });

  projectRail?.addEventListener('click', (event) => {
    if (suppressClick) {
      event.preventDefault();
      suppressClick = false;
      return;
    }

    const clickedItem = event.target instanceof Element
      ? event.target.closest<HTMLElement>('.project-rail-item')
      : null;

    if (clickedItem && !clickedItem.classList.contains('is-active')) {
      setActiveProject(Number(clickedItem.dataset.index));
      return;
    }

    const activeRect = railItems[activeIndex]?.getBoundingClientRect();
    if (!activeRect) return;
    if (event.clientX < activeRect.left) setActiveProject(activeIndex - 1);
    if (event.clientX > activeRect.right) setActiveProject(activeIndex + 1);
  });

  projectRail?.addEventListener('pointerdown', (event) => {
    if (event.button !== 0 || !event.isPrimary) return;
    pointerStart = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
  });

  window.addEventListener('pointerup', (event) => {
    if (!pointerStart || event.pointerId !== pointerStart.pointerId) return;

    const deltaX = event.clientX - pointerStart.x;
    const deltaY = event.clientY - pointerStart.y;
    pointerStart = null;

    if (Math.abs(deltaX) < 48 || Math.abs(deltaX) < Math.abs(deltaY) * 1.2) return;

    suppressClick = true;
    setActiveProject(activeIndex + (deltaX < 0 ? 1 : -1));
    window.setTimeout(() => {
      suppressClick = false;
    }, 0);
  });

  window.addEventListener('pointercancel', () => {
    pointerStart = null;
  });

  setActiveProject(0);
  window.addEventListener('resize', () => setActiveProject(activeIndex));
</script>

<style>
  .project-rail-wrap {
    overflow: visible;
    perspective: 1800px;
  }

  .project-rail {
    position: relative;
    min-height: 34rem;
    transform-style: preserve-3d;
    touch-action: pan-y;
  }

  .project-rail-item {
    position: absolute;
    top: 50%;
    left: calc(50% + var(--rail-x-offset, 0px));
    width: min(78vw, 35rem);
    cursor: pointer;
    opacity: 0.4;
    transform-style: preserve-3d;
    transform: translate(-50%, -50%) translateZ(-380px) scale(0.6);
    will-change: transform, opacity;
    backface-visibility: hidden;
    transition:
      transform 760ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 520ms ease;
  }

  .project-rail-item.is-active {
    z-index: 4;
    opacity: 1;
    cursor: default;
    pointer-events: none;
    transform: translate(-50%, -50%) translateZ(0) scale(1);
  }

  .project-rail-item.is-left {
    z-index: 3;
    opacity: 0.75;
    pointer-events: auto;
    transform: translate(-50%, -50%) translateZ(-180px) rotateY(24deg) scale(0.64);
  }

  .project-rail-item.is-right {
    z-index: 3;
    opacity: 0.75;
    pointer-events: auto;
    transform: translate(-50%, -50%) translateZ(-180px) rotateY(-24deg) scale(0.64);
  }

  @media (max-width: 767px) {
    .project-rail {
      min-height: 25rem;
    }

    .project-rail-item {
      width: 84vw;
    }

    .project-rail-item.is-left {
      transform: translate(-50%, -50%) translateZ(-140px) rotateY(20deg) scale(0.6);
    }

    .project-rail-item.is-right {
      transform: translate(-50%, -50%) translateZ(-140px) rotateY(-20deg) scale(0.6);
    }
  }

  .project-rail-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }

</style>
