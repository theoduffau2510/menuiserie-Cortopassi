---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { villes } from '../../data/villes';
---

<BaseLayout
  title="Zone d'intervention dans le Var | Menuiserie Cortopassi"
  description="Menuiserie Cortopassi intervient depuis Sainte-Anastasie-sur-Issole dans tout le Var : Toulon, Draguignan, Fréjus, Saint-Raphaël, Hyères, Brignoles et bien d'autres communes."
  path="/zone-intervention/"
>
  <section class="section pt-10 md:pt-16">
    <div class="container-page">
      <div class="max-w-2xl mb-12">
        <p class="text-cordeau font-medium text-sm mb-3">Zone d'intervention</p>
        <h1 class="text-4xl md:text-5xl mb-4">Notre zone d'intervention dans le Var</h1>
        <p class="text-noyer/75">
          Basé à Sainte-Anastasie-sur-Issole, j'interviens comme menuisier artisan dans l'ensemble du département du
          Var, de Toulon à Sainte-Maxime. Découvrez les principales villes où je réalise mes
          prestations de mobilier aux dimensions du lieu, d'agencement et de rénovation.
        </p>
      </div>

      <div class="border-t border-noyer/25">
        {
          villes.map((ville) => (
            <a href={`/zone-intervention/${ville.slug}/`} class="grid gap-3 border-b border-noyer/25 py-5 md:grid-cols-[1fr_1.5fr_0.7fr] md:items-baseline hover:text-cordeau">
              <h2 class="text-2xl">Menuisier à {ville.name}</h2>
              <p class="text-sm text-noyer/75">{ville.description}</p>
              <p class="text-xs text-cordeau font-medium md:text-right">{ville.distance}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title="Votre ville n'est pas dans la liste ?"
    text="Je me déplace dans tout le Var. Contactez-moi pour vérifier la disponibilité sur votre secteur."
  />
</BaseLayout>
